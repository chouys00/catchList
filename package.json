{
  "name": "catchlist",
  "private": true,
  "version": "1.0.0",
  "description": "動畫/電影/遊戲三個抓取專案的 monorepo",
  "type": "module",
  "workspaces": [
    "packages/*",
    "imdb_tracker",
    "spiderMAL",
    "steam_discovery"
  ],
  "scripts": {
    "update:anime": "npm run update --workspace spiderMAL",
    "update:movies": "npm run update --workspace imdb_tracker",
    "update:games": "npm run update --workspace steam_discovery",
    "update:all": "node scripts/update-all.mjs"
  }
}
