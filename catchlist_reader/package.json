{
  "name": "catchlist-reader",
  "version": "1.0.8",
  "private": true,
  "description": "CatchList 動畫、電影、遊戲與真人劇 Markdown 桌面閱讀器",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "manual:large-games": "node test-support/launch-large-game-manual.mjs",
    "test": "node --test --experimental-test-isolation=none",
    "build:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "tw.catchlist.reader",
    "productName": "CatchListReader",
    "icon": "src/assets/catchlist.ico",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "CatchListReader.${ext}"
    }
  }
}
