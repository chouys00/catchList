{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatchListReader",
  "version": "1.0.3",
  "identifier": "tw.catchlist.reader",
  "build": {
    "frontendDist": "../src/tauri-shell"
  },
  "app": {
    "windows": [
      {
        "title": "CatchList 閱讀器",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["../src/assets/catchlist.ico"]
  }
}
